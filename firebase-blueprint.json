{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Print product available in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "nameMr": { "type": "string", "maxLength": 200 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "basePrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "image": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "minQuantity": { "type": "number" },
        "defaultQuantity": { "type": "number" },
        "turnaroundDays": { "type": "number" },
        "isPopular": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" }
      },
      "required": ["id", "name", "categoryId", "basePrice"]
    },
    "Category": {
      "title": "Category",
      "description": "Commercial print product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "nameMr": { "type": "string", "maxLength": 150 },
        "shortName": { "type": "string", "maxLength": 100 },
        "iconName": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 1000 },
        "itemCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Commercial print job order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "maxLength": 20 },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "total"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Hero banner slide configured for homepage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title1": { "type": "string", "maxLength": 200 },
        "title2": { "type": "string", "maxLength": 200 },
        "highlight": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 1000 },
        "buttonText": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title1", "image"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Print orders"
    },
    "/hero_slides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Homepage hero banner slides"
    }
  }
}
